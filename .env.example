# Copie este arquivo para ".env" e preencha quando escolher os provedores.
# Enquanto essas variáveis não existirem, o app roda em modo simulado
# (nenhuma mensagem/ligação real é enviada — tudo fica só na timeline do lead).

# Login — obrigatório configurar antes de colocar em produção.
# SESSION_SECRET assina o cookie de sessão; sem essa variável o app usa
# uma chave fixa de desenvolvimento (não é seguro fora do seu computador).
# Gere uma com: openssl rand -base64 32
SESSION_SECRET=
# ADMIN_USERNAME/ADMIN_PASSWORD só valem na primeira execução (criação da
# conta inicial) — depois de existir alguém em "users" no banco, mudar
# essas variáveis não muda a senha de ninguém. Sem elas, a conta padrão
# fica admin/meetcloser123 (troque assim que entrar).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# WhatsApp (ex: Meta Cloud API, Twilio, Z-API)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Instagram (Graph API / Meta)
INSTAGRAM_API_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# IA de voz / ligações (ex: Vapi, Bland AI, Retell AI, Twilio+LLM)
VOICE_AI_PROVIDER=
VOICE_AI_API_KEY=
VOICE_AI_AGENT_ID=
