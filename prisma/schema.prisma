generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  name          String
  passwordHash  String   @map("password_hash")
  isAdmin       Boolean  @default(false) @map("is_admin")
  isApproved    Boolean  @default(false) @map("is_approved")
  googleAccessToken  String? @map("google_access_token")
  googleRefreshToken String? @map("google_refresh_token")
  googleTokenExpiry  DateTime? @map("google_token_expiry")
  createdAt     DateTime @default(now()) @map("created_at")

  auditLogs     AuditLog[]
  leads         Lead[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_log")
}

model Lead {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  email     String?
  phone     String?
  whatsapp  String?
  instagram String?
  source    String?
  mode      Mode     @default(MODO_1)
  status    LeadStatus @default(NOVO)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    ConversationEvent[]
  tags      LeadTag[]
  meeting   Meeting?

  @@map("leads")
}

model ConversationEvent {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  channel   Channel
  direction Direction
  content   String
  scriptId  String?  @map("script_id")
  createdAt DateTime @default(now()) @map("created_at")

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  script    Script?  @relation(fields: [scriptId], references: [id], onDelete: SetNull)

  @@map("conversation_events")
}

model LeadTag {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, label])
  @@map("lead_tags")
}

model Meeting {
  id          String   @id @default(uuid())
  leadId      String   @unique @map("lead_id")
  scheduledAt DateTime @map("scheduled_at")
  status      MeetingStatus @default(AGENDADA)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("meetings")
}

model Script {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  version   Int      @default(1)
  name      String
  mode      Mode
  channel   Channel
  content   String
  weight    Int      @default(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events    ConversationEvent[]

  @@map("scripts")
}

enum Mode {
  MODO_1
  MODO_2
}

enum LeadStatus {
  NOVO
  CONTATADO
  RESPONDENDO
  REUNIAO_AGENDADA
  FECHADO
  PERDIDO
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  LIGACAO
  SISTEMA
}

enum Direction {
  SAIDA
  ENTRADA
}

enum MeetingStatus {
  AGENDADA
  REALIZADA
  CANCELADA
}
